{
  "name": "be-reasonable",
  "version": "0.3.0",
  "description": "Simplify code without sacrificing correctness, keep tests focused on behavior, keep changelogs readable.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "agent-skills",
    "skills",
    "ai-agents",
    "code-review",
    "code-simplification",
    "maintainability",
    "test-quality",
    "testing",
    "changelog",
    "verbosity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexParamonov/be-reasonable.git"
  },
  "files": [
    "skills",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^24.19.2",
    "typebox": "^1.4.7",
    "vite-plus": "^1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./src/index.ts"
    ]
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
